# Experimental Azure-era recipe; not a supported local quickstart.
# Spec: docs/design/azure-adapter.md (ca-agent Container App).
# Invariants:
#   - Same four-stage shape + non-root user + runtime-deps-only image as
#     Dockerfile (ca-webhook). The only differences are the CMD entrypoint
#     (mainAgent.ts) and the HEALTHCHECK path (/health, not /admin/health).
#   - AGENT_HMAC_SECRET MUST be bound at runtime (Key Vault `secretRef`).
#   - Listens on port 8080. PORT/BIND_HOST overridable via env.

FROM node:20-alpine AS deps-prod
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json tsconfig.json ./
COPY src ./src
RUN npx tsc --noEmit

FROM node:20-alpine AS runtime
WORKDIR /app

RUN addgroup --system --gid 1001 appgroup \
    && adduser --system --uid 1001 --ingroup appgroup --shell /sbin/nologin appuser

ENV NODE_ENV=production \
    PORT=8080 \
    BIND_HOST=0.0.0.0

COPY --from=deps-prod --chown=appuser:appgroup /app/node_modules ./node_modules
COPY --chown=appuser:appgroup package.json package-lock.json tsconfig.json ./
COPY --chown=appuser:appgroup src ./src

USER appuser
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider "http://127.0.0.1:${PORT:-8080}/health" || exit 1

CMD ["npx", "tsx", "src/mainAgent.ts"]
