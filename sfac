#!/bin/sh
# Local Docker-only operator interface. No environment file is executed as shell.
set -eu
umask 077
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
state=${SFAC_STATE_DIR:-"$root/.factory"}
case "$state" in /*) ;; *) echo 'SFAC_STATE_DIR must be absolute' >&2; exit 2;; esac
case "$state" in "$root/.factory") ;; "$root"|"$root"/*) echo 'Custom state must be outside the source build context' >&2; exit 2;; esac
command=${1:-help}
[ "$#" -eq 0 ] || shift
if [ "$command" = help ]; then
  echo 'Usage: ./sfac init --mode demo|live [options]'
  echo '       ./sfac build|up|stop|down|clean-images|ps|logs|ready|demo|status|demo-status'
  echo '       ./sfac demo-source NAME | worker COMMAND ... | recovery COMMAND ...'
  echo '       ./sfac autonomy intent|pin|activate|status|grant|revoke|pause|resume|approve|reconcile|run|cancel|merge|merge-scan|recover ...'
  echo '       ./sfac backup FILE | restore-check FILE | verify-database | prepare-result ...'
  echo 'Paths passed to operator commands are relative to .factory/artifacts (or /artifacts).'
  exit 0
fi
[ "$(id -u)" != 0 ] || { echo 'Run as a non-root local operator' >&2; exit 2; }
endpoint=${DOCKER_HOST:-$(docker context inspect --format '{{.Endpoints.docker.Host}}')}
case "$endpoint" in unix://*) ;; *) echo 'A local Unix-socket Docker context is required' >&2; exit 2;; esac
if [ "$command" = init ]; then
  [ ! -e "$state/.env" ] && [ ! -e "$state/secrets" ] || { echo 'Configuration exists; see docs/credentials.md' >&2; exit 2; }
  mkdir -p "$state/artifacts"
  state=$(CDPATH= cd -- "$state" && pwd -P)
  case "$state" in "$root/.factory") ;; "$root"|"$root"/*) echo "Custom state must be outside the source build context" >&2; exit 2;; esac
  chmod 700 "$state" "$state/artifacts"
  [ -e "$state/project" ] || { printf 'factory-%s-%s\n' "$(date +%Y%m%d%H%M%S)" "$$" > "$state/project"; }
fi
[ -d "$state" ] || { echo "Run ./sfac init first" >&2; exit 2; }
state=$(CDPATH= cd -- "$state" && pwd -P) || exit 2
case "$state" in "$root/.factory") ;; "$root"|"$root"/*) echo 'Custom state must be outside the source build context' >&2; exit 2;; esac
[ -f "$state/project" ] || { echo 'Run ./sfac init first' >&2; exit 2; }
project=$(cat "$state/project")
case "$project" in ''|*[!a-z0-9-]*) echo 'Invalid project name' >&2; exit 2;; esac
export FACTORY_STATE_DIR="$state"
export FACTORY_LOCAL_IMAGE="$project-local:development"
export FACTORY_WORKER_IMAGE="$project-worker:development"
export FACTORY_OPERATOR_IMAGE="$project-operator:development"
build_operator() { docker build -f "$root/runtime/operator/Dockerfile" -t "$FACTORY_OPERATOR_IMAGE" "$root"; }
if [ "$command" = init ]; then
  build_operator
  exec docker run --rm --init --user "$(id -u):$(id -g)" --network none --read-only --tmpfs /tmp:size=128m --memory 512m --memory-swap 512m --pids-limit 128 --cpus 1 --log-driver none --cap-drop ALL --security-opt no-new-privileges --mount "type=bind,src=$state,dst=/state" -e FACTORY_STATE_DIR=/state "$FACTORY_OPERATOR_IMAGE" init "$@"
fi
[ -f "$state/.env" ] || { echo "Initialization is incomplete; finish ./sfac init first" >&2; exit 2; }
# The review services mount merge-policy/ (a directory, so edits that replace the file reach the
# running control plane); a policy in the state root is the retired layout and is refused.
if [ -e "$state/merge-policy.json" ] || [ -L "$state/merge-policy.json" ]; then
  echo "Move $state/merge-policy.json to $state/merge-policy/merge-policy.json: the review services mount the merge-policy/ directory." >&2; exit 2
fi
if [ -e "$state/merge-policy" ] && [ ! -f "$state/merge-policy/merge-policy.json" ]; then
  echo "$state/merge-policy holds no regular file merge-policy.json; add it or remove the directory." >&2; exit 2
fi
compose() {
  if grep -qx 'FACTORY_MODE=live' "$state/.env"; then
    if [ -f "$state/merge-policy/merge-policy.json" ]; then
      docker compose --project-directory "$root/runtime" --env-file "$state/.env" -p "$project" -f "$root/runtime/compose.yaml" -f "$root/runtime/compose.operator.yaml" -f "$root/runtime/compose.live.yaml" -f "$root/runtime/compose.review.yaml" -f "$root/runtime/compose.operator-review.yaml" "$@"
    else
      docker compose --project-directory "$root/runtime" --env-file "$state/.env" -p "$project" -f "$root/runtime/compose.yaml" -f "$root/runtime/compose.operator.yaml" -f "$root/runtime/compose.live.yaml" "$@"
    fi
  else
    docker compose --project-directory "$root/runtime" --env-file "$state/.env" -p "$project" -f "$root/runtime/compose.yaml" -f "$root/runtime/compose.operator.yaml" "$@"
  fi
}
case "$command" in
  build) build_operator; compose build migrate; docker build -f "$root/runtime/worker/Dockerfile" -t "$FACTORY_WORKER_IMAGE" "$root";;
  up) compose up -d --wait db migrate runtime;;
  stop|ps|logs) compose "$command" "$@";;
  down) compose down "$@";;
  clean-images)
    [ "$#" = 0 ] || { echo 'clean-images accepts no arguments' >&2; exit 2; }
    [ -z "$(docker ps -aq --filter "label=com.docker.compose.project=$project")" ] || { echo 'Run ./sfac down first; installation containers still exist' >&2; exit 2; }
    for component in operator local worker; do
      tag="$project-$component:development"
      if docker image inspect "$tag" >/dev/null 2>&1; then docker image rm "$tag"; fi
    done
    echo 'Installation image tags removed; private configuration and artifacts retained.';;
  worker)
    case "${1:-}" in
      run|run-activation|recover)
        FACTORY_DOCKER_GID=$(docker run --rm --network none --read-only --memory 64m --memory-swap 64m --pids-limit 16 --cpus 1 --log-driver none --cap-drop ALL --mount "type=bind,src=${FACTORY_DOCKER_SOCKET:-/var/run/docker.sock},dst=/var/run/docker.sock,readonly" --entrypoint python3 "$FACTORY_OPERATOR_IMAGE" -c 'import os; print(os.stat("/var/run/docker.sock").st_gid)')
        export FACTORY_DOCKER_GID
        case "$1" in run) service=demo-supervisor;; run-activation) service=live-supervisor;; recover) service=supervisor;; esac
        compose run --rm --no-deps -T "$service" worker "$@";;
      status|cancel|prune|activations) compose run --rm --no-deps -T database-operator worker "$@";;
      github-check|prepare-task|record-pr|track-pr|review-scan|review-status)
        compose run --rm --no-deps -T github-operator worker "$@";;
      *) echo 'Unknown worker command' >&2; exit 2;;
    esac;;
  autonomy)
    case "${1:-}" in
      run|cancel|merge|merge-scan|recover|pin|intent)
        FACTORY_DOCKER_GID=$(docker run --rm --network none --read-only --memory 64m --memory-swap 64m --pids-limit 16 --cpus 1 --log-driver none --cap-drop ALL --mount "type=bind,src=${FACTORY_DOCKER_SOCKET:-/var/run/docker.sock},dst=/var/run/docker.sock,readonly" --entrypoint python3 "$FACTORY_OPERATOR_IMAGE" -c 'import os; print(os.stat("/var/run/docker.sock").st_gid)')
        export FACTORY_DOCKER_GID
        if grep -qx 'FACTORY_MODE=live' "$state/.env"; then service=live-autonomy-supervisor; else service=demo-autonomy-supervisor; fi
        # The merger App key is mounted only for the merge commands of an installation that opted in.
        case "$1" in merge|merge-scan)
          if [ "$service" = live-autonomy-supervisor ] && grep -qx 'FACTORY_AUTOMERGE=enabled' "$state/.env"; then service=live-automerge-supervisor; fi;;
        esac
        compose run --rm --no-deps -T "$service" autonomy "$@";;
      activate|status|grant|revoke|pause|resume|approve|reconcile)
        compose run --rm --no-deps -T autonomy-operator autonomy "$@";;
      *) echo 'Unknown autonomy command' >&2; exit 2;;
    esac;;
  backup)
    [ "$#" = 1 ] || { echo 'Specify one new backup filename' >&2; exit 2; }
    case "$1" in ''|*[!a-zA-Z0-9._-]*|.*) echo 'Use a simple backup filename' >&2; exit 2;; esac
    # Noclobber avoids overwriting an existing backup, including symlinks.
    (set -C; compose exec -T db pg_dump -U factory_migrator -d software_factory --format=custom > "$state/artifacts/$1")
    echo "Backup created: $state/artifacts/$1";;
  restore-check)
    [ "$#" = 1 ] || { echo 'Specify one backup filename' >&2; exit 2; }
    case "$1" in ''|*[!a-zA-Z0-9._-]*|.*) echo 'Use a simple backup filename' >&2; exit 2;; esac
    restore_db="factory_restore_$(date +%s)_$$"
    compose exec -T db createdb -U factory_migrator "$restore_db"
    trap 'compose exec -T db dropdb -U factory_migrator "$restore_db"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' HUP TERM
    compose exec -T db pg_restore --exit-on-error --no-owner -U factory_migrator -d "$restore_db" < "$state/artifacts/$1"
    compose run --rm --no-deps -T database-operator verify-database "$restore_db";;
  ready) compose run --rm --no-deps -T probe ready "$@";;
  demo) compose run --rm --no-deps -T demo-operator demo "$@";;
  status|demo-status|recovery|verify-database|compact)
    compose run --rm --no-deps -T database-operator "$command" "$@";;
  demo-source|prepare-result) compose run --rm --no-deps -T operator "$command" "$@";;
  *) echo 'Unknown command; use ./sfac help' >&2; exit 2;;
esac
